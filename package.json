{
  "name": "consensus-trace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Source-bound, read-only live test verification for GenLayer Intelligent Contracts",
  "engines": { "node": ">=24.11.0" },
  "scripts": {
    "dev": "tsx watch src/server/index.ts --dev",
    "start": "tsx src/server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "trace": "tsx src/cli/index.ts",
    "mcp": "tsx src/mcp/index.ts",
    "verify:bundle": "tsx src/cli/verify.ts"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "fflate": "0.8.3",
    "genlayer-js": "1.1.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
